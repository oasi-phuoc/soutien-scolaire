{
  "name": "soutien-scolaire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit:phonemes": "npx tsx scripts/audit-lecture-phonemes.ts",
    "generate:lecture-words": "npx tsx scripts/generate-lecture-word-items.ts",
    "generate:offline-manifest": "node scripts/generate-offline-manifest.cjs",
    "generate:word-audio": "npx --yes tsx scripts/generate-word-audio-list.ts && npx --yes tsx scripts/generate-vocab-audio-list.ts && python3 scripts/generate-word-audio.py --voice f && python3 scripts/generate-word-audio.py --voice m",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:sync": "npx cap sync && node scripts/patch-ios-light-mode.mjs",
    "mobile:android": "npx cap open android",
    "mobile:android:sync": "npx cap sync android && node scripts/patch-ios-light-mode.mjs",
    "mobile:android:apk": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "mobile:android:apk:release": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "mobile:ios": "npx cap open ios",
    "mobile:ios:init": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.4.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^0.511.0",
    "next": "^15.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
