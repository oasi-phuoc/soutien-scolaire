# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Laisser vide : pas de compte cloud (progression navigateur uniquement).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique (local ou Vercel). Pour e-mail / OAuth : même URL dans le tableau Auth de Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App mobile Capacitor — URL HTTPS publique de l'app avant `npm run mobile:sync`
CAPACITOR_SERVER_URL=https://soutien-van.vercel.app

# Optionnel — active les réponses IA dans la section Parler.
# Sans clé, l'exercice conversationnel fonctionne avec une réponse locale simple.
OPENAI_API_KEY=
OPENAI_COMMUNICATION_MODEL=gpt-4.1-mini

# ── Mode édition contenu (admin) ──────────────────────────────────────────────
# Force l'accès édition même sans rôle admin (dev local uniquement).
# CONTENT_EDIT_OPEN=1

# Token GitHub — à créer manuellement (ce n'est PAS une variable déjà fournie) :
# 1. GitHub → Settings → Developer settings → Personal access tokens
# 2. Fine-grained ou classic, permission Contents: Read and write sur ce dépôt
# 3. Coller la valeur ici ou dans Vercel → Environment Variables (Production + Redeploy)
#    Alternative : Admin → Contenu → Sync GitHub (stocké dans Supabase, sans redeploy)
# CONTENT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTENT_GITHUB_REPO=oasi-phuoc/soutien-scolaire
# CONTENT_GITHUB_BRANCH=main

# Service role Supabase (écritures admin : overrides, comptes, images…)
# SUPABASE_SERVICE_ROLE_KEY=
